{
  "version": 2,
  "builds": [
    {
      "src": "api/ml/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ml/(predict|health)",
      "dest": "/api/ml/$1.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
